<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/profile_bg"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/profile_border">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Subtle Diagonal Header -->
        <ImageView
            android:id="@+id/header_bg"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:scaleType="fitXY"
            android:src="@drawable/bg_profile_header_diagonal"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title & Close Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:paddingHorizontal="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/lexend"
                    android:text="StealthPad"
                    android:textColor="@color/profile_text_primary"
                    android:textSize="20sp"

                    android:letterSpacing="-0.03" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_close_profile"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:icon="@android:drawable/ic_menu_close_clear_cancel"
                    app:iconTint="@color/profile_text_secondary"
                    app:iconSize="20dp" />
            </RelativeLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp"
                    android:paddingBottom="32dp"
                    android:gravity="center_horizontal">

                    <!-- Profile Info -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="90dp"
                        android:layout_height="90dp"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="45dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/white_background"
                        app:cardBackgroundColor="@color/white_background">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/profileAnimation"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/useravatar" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/text_full_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/lexend"
                        tools:text="Stealth User"
                        android:textColor="@color/profile_text_primary"
                        android:textSize="20sp"
                         />

                    <TextView
                        android:id="@+id/text_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        tools:text="user@email.com"
                        android:textColor="@color/profile_text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_manage_account"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Account Settings"
                        android:textColor="@color/profile_text_primary"
                        app:backgroundTint="@color/profile_accent_light"
                        app:cornerRadius="12dp"
                        android:textSize="13sp"
                        android:fontFamily="@font/lexend"
                        android:paddingHorizontal="20dp"
                        app:icon="@drawable/accsetting"
                        app:iconTint="@color/profile_text_primary"
                        app:iconSize="16dp" />

                    <!-- Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:orientation="vertical">

                            <!-- Reset Password Item -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_reset_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/white_background"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/profile_border"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="14dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/reset"
                                    app:tint="@color/profile_accent"
                                    android:importantForAccessibility="no" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:fontFamily="@font/lexend"
                                    android:text="Reset Password"
                                    android:textColor="@color/profile_text_primary"
                                    android:textSize="15sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                            <!-- Delete Account Item -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/btn_delete_account"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/white_background"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/profile_border"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="14dp">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:src="@drawable/delete"
                                    app:tint="@color/profile_danger"
                                    android:importantForAccessibility="no" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:fontFamily="@font/lexend"
                                    android:text="Delete Account"
                                    android:textColor="@color/profile_danger"
                                    android:textSize="15sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                    <!-- Logout Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_logout"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="32dp"
                        android:text="Logout"
                        android:textColor="@color/profile_danger"
                        app:backgroundTint="@color/profile_danger_bg"
                        app:cornerRadius="14dp"
                        app:elevation="0dp"
                        android:fontFamily="@font/lexend"
                        android:textSize="16sp"

                        app:icon="@drawable/logout"
                        app:iconTint="@color/profile_danger"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp" />

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/loading_indicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:visibility="gone"
                        app:indicatorColor="@color/warm_accent"
                        android:indeterminate="true" />

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
