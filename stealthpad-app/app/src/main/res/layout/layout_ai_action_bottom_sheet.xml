<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ai_bottom_sheet_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/ai_panel_bg"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp"
        app:shapeAppearanceOverlay="@style/RoundedTopCorners"
        app:strokeWidth="0dp">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingBottom="40dp">

                <!-- Drag Handle & Branding -->
                <com.google.android.material.bottomsheet.BottomSheetDragHandleView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/lexend"
                        android:letterSpacing="0.2"
                        android:text="STEALTH AI"
                        android:textColor="@color/ai_text_secondary"
                        android:textSize="11sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/stealthai"
                        app:tint="@color/ai_sparkle" />
                </LinearLayout>

                <!-- Mascot Area -->
                <ImageView
                    android:id="@+id/ai_mascot_img"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:alpha="0.9"
                    android:src="@drawable/stealthmascot" />

                <!-- Header Section -->
                <TextView
                    android:id="@+id/text_ai_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/lexend"
                    android:gravity="center"
                    android:text="Summarize your note"
                    android:textColor="@color/ai_text_primary"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/text_ai_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Turn your thoughts into a clear, concise summary."
                    android:textColor="@color/ai_text_secondary"
                    android:textSize="14sp" />

                <!-- Input Section -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_ai_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    app:cardBackgroundColor="@color/ai_card_bg"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/ai_divider"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/icon_input_type"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="Type"
                                android:src="@drawable/category"
                                app:tint="@color/ai_text_secondary" />

                            <TextView
                                android:id="@+id/label_input_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.05"
                                android:text="Your note"
                                android:textAllCaps="true"
                                android:textColor="@color/ai_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:boxBackgroundMode="none"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_ai_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@null"
                                android:fontFamily="sans-serif"
                                android:gravity="top"
                                android:hint="Paste or type your note here..."
                                android:inputType="textMultiLine"
                                android:minLines="3"
                                android:padding="0dp"
                                android:textColor="@color/ai_text_primary"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/text_char_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="8dp"
                            android:text="0 / 10,000"
                            android:textColor="@color/ai_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Chips Suggestions -->
                <HorizontalScrollView
                    android:id="@+id/scroll_suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_suggestions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true" />
                </HorizontalScrollView>

                <!-- Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ai_action"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/lexend"
                    android:text="✨ Summarize with Stealth AI"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:backgroundTint="@color/ai_accent"
                    app:cornerRadius="20dp"
                    app:elevation="4dp" />

                <!-- Result Section (Dynamic) -->
                <LinearLayout
                    android:id="@+id/container_ai_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/text_result_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1"
                        android:text="YOUR SUMMARY"
                        android:textColor="@color/ai_text_secondary"
                        android:textSize="12sp" />

                    <!-- Standard Document Result -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_text_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="@color/ai_card_bg"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="1dp"
                        app:strokeColor="@color/ai_divider"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/text_ai_result"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="6sp"
                            android:padding="20dp"
                            android:textColor="@color/ai_text_primary"
                            android:textIsSelectable="true"
                            android:textSize="15sp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Key Points List Result -->
                    <LinearLayout
                        android:id="@+id/list_key_points"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <!-- Result Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_copy_result"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Copy"
                            android:textColor="@color/ai_text_secondary" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:layout_marginHorizontal="12dp"
                            android:background="@color/ai_divider" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_use_note"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Use in Note"
                            android:textColor="@color/ai_accent" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="24dp"
                            android:layout_marginHorizontal="12dp"
                            android:background="@color/ai_divider" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_retry"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Try Again"
                            android:textColor="@color/ai_text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
