<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Top Navigation Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="10dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                app:cardBackgroundColor="@color/dash_card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true"
                app:strokeColor="@color/dash_divider"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:src="@drawable/back"
                    app:tint="@color/dash_text_primary" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnDeleteNote"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_toStartOf="@id/btnSaveNote"
                android:layout_marginEnd="10dp"
                android:layout_centerVertical="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/dash_card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true"
                app:strokeColor="@color/dash_divider"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:src="@drawable/delete"
                    app:tint="@color/profile_danger" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveNote"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/lexend"
                android:text="Save Note"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:paddingHorizontal="20dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/stealth_taupe"
                app:cornerRadius="15dp"
                app:elevation="2dp"
                app:icon="@drawable/ic_check"
                app:iconSize="18dp"
                app:iconPadding="8dp"
                app:iconTint="@color/white"
                app:rippleColor="#20FFFFFF" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAiNote"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_toStartOf="@id/btnAddImage"
                android:layout_marginEnd="10dp"
                android:layout_centerVertical="true"
                app:cardBackgroundColor="@color/dash_card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true"
                app:strokeColor="@color/dash_divider"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:src="@drawable/ic_ai"
                    app:tint="@color/dash_accent" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAddImage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_toStartOf="@id/btnDeleteNote"
                android:layout_marginEnd="10dp"
                android:layout_centerVertical="true"
                app:cardBackgroundColor="@color/dash_card_bg"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true"
                app:strokeColor="@color/dash_divider"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/dash_accent" />
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>

        <!-- Date Indicator -->
        <TextView
            android:id="@+id/textDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="sans-serif-light"
            android:text="--- --- ---"
            android:textColor="@color/dash_text_secondary"
            android:textSize="12sp" />

        <!-- Title Input -->
        <EditText
            android:id="@+id/inputNoteTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@null"
            android:fontFamily="sans-serif-medium"
            android:hint="Note Title"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:textColor="@color/dash_text_primary"
            android:textColorHint="@color/muted_beige"
            android:textSize="28sp" />

        <!-- Category Selector -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/categoryChipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:chipSpacingHorizontal="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPersonal"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cat_personal"
                    app:chipBackgroundColor="@color/dash_card_bg"
                    app:chipStrokeColor="@color/dash_divider"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWork"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cat_work"
                    app:chipBackgroundColor="@color/dash_card_bg"
                    app:chipStrokeColor="@color/dash_divider"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipIdeas"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cat_ideas"
                    app:chipBackgroundColor="@color/dash_card_bg"
                    app:chipStrokeColor="@color/dash_divider"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSecure"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cat_secure"
                    app:chipBackgroundColor="@color/dash_card_bg"
                    app:chipStrokeColor="@color/dash_divider"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipImportant"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cat_important"
                    app:chipBackgroundColor="@color/dash_card_bg"
                    app:chipStrokeColor="@color/dash_divider"
                    app:chipStrokeWidth="1dp" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Attachments List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_attachments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_attachment"
            tools:visibility="visible" />

        <!-- Content Input -->
        <EditText
            android:id="@+id/inputNoteContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="sans-serif"
            android:gravity="top"
            android:hint="Start typing your ideas here..."
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:textColor="@color/dash_text_primary"
            android:textColorHint="@color/muted_beige"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- New Reusable Stealth Navbar -->
    <com.kavya.stealthpad.ui.components.StealthNavBar
        android:id="@+id/stealth_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_bar_height"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loading_indicator"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:visibility="gone"
        app:indicatorSize="48dp"
        app:trackThickness="4dp"
        android:indeterminate="true"
        android:layout_gravity="center"/>


</androidx.coordinatorlayout.widget.CoordinatorLayout>
