<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="com.google.android.material.card.MaterialCardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="5">

        <!-- Slot 1: Home -->
        <FrameLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:id="@+id/container_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/nav_item_background"
                android:duplicateParentState="true">

                <ImageView
                    android:id="@+id/icon_home"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/home"
                    android:duplicateParentState="true"
                    app:tint="@color/nav_item_text_color" />

                <TextView
                    android:id="@+id/label_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Home"
                    android:duplicateParentState="true"
                    android:textColor="@color/nav_item_text_color"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Slot 2: Stealth AI -->
        <FrameLayout
            android:id="@+id/nav_ai"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:id="@+id/container_ai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/nav_item_background"
                android:duplicateParentState="true">

                <ImageView
                    android:id="@+id/icon_ai"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/stealthai"
                    android:duplicateParentState="true"
                    app:tint="@color/nav_item_text_color" />

                <TextView
                    android:id="@+id/label_ai"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Stealth AI"
                    android:duplicateParentState="true"
                    android:textColor="@color/nav_item_text_color"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Slot 3: Add (Center) -->
        <FrameLayout
            android:id="@+id/nav_add"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/dash_accent"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_add"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Slot 4: Vault -->
        <FrameLayout
            android:id="@+id/nav_vault"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:id="@+id/container_vault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/nav_item_background"
                android:duplicateParentState="true">

                <ImageView
                    android:id="@+id/icon_vault"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/vault"
                    android:duplicateParentState="true"
                    app:tint="@color/nav_item_text_color" />

                <TextView
                    android:id="@+id/label_vault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Vault"
                    android:duplicateParentState="true"
                    android:textColor="@color/nav_item_text_color"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Slot 5: More -->
        <FrameLayout
            android:id="@+id/nav_more"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <LinearLayout
                android:id="@+id/container_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/nav_item_background"
                android:duplicateParentState="true">

                <ImageView
                    android:id="@+id/icon_more"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/more"
                    android:duplicateParentState="true"
                    app:tint="@color/nav_item_text_color" />

                <TextView
                    android:id="@+id/label_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="More"
                    android:duplicateParentState="true"
                    android:textColor="@color/nav_item_text_color"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</merge>
