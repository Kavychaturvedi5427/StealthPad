<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="25dp">

            <!-- Top Header (Greeting + Image) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="25dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/greetingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Good Evening, User"
                        android:textColor="@color/dash_text_primary"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-light"
                        android:text="Your safe space for ideas."
                        android:textColor="@color/dash_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/authbtn"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/auth_img"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="6dp"
                        android:background="@color/white"
                        android:src="@drawable/logo"
                        app:shapeAppearanceOverlay="@style/CircleImage"
                        app:strokeColor="@color/dash_accent"
                        app:strokeWidth="1.5dp"/>

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/profileAnimation"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        app:lottie_rawRes="@raw/useravatar"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"/>

                </FrameLayout>

            </RelativeLayout>

            <!-- Section Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="32dp"
                android:background="@color/dash_divider"
                android:alpha="0.8" />

            <!-- Recent Notes Section (Displaying Top 3 Notes) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="25dp">

                <TextView
                    android:id="@+id/recentNotesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/recent_notes"
                    android:layout_centerVertical="true"
                    android:textColor="@color/dash_text_primary"
                    android:textSize="20sp"
                    android:letterSpacing="-0.02" />

                <!-- View All Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewAll"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="View All Notes"
                    android:textColor="@color/dash_accent"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />



            </RelativeLayout>

            <FrameLayout
                android:id="@+id/notesWindow"
                android:layout_width="match_parent"
                android:layout_height="420dp"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_window_boundary"
                android:clipToOutline="true">

                <!-- Subtle window gloss/detail -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewNotes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:fadingEdgeLength="40dp"
                    android:overScrollMode="never"
                    android:paddingVertical="16dp"
                    android:requiresFadingEdge="vertical"
                    android:scrollbarStyle="insideOverlay"
                    android:scrollbars="vertical"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_note_folder" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@color/muted_beige"
                    android:alpha="0.3" />

                <LinearLayout
                    android:id="@+id/empty_state_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/empty"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:visibility="gone"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true" />

                    <TextView
                        android:id="@+id/empty_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/lexend"
                        android:text="@string/no_notes_found"
                        android:textColor="@color/dash_accent"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <!-- Browse Categories Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="25dp">

                <TextView
                    android:id="@+id/categoriesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Browse Categories"
                    android:layout_centerVertical="true"
                    android:textColor="@color/dash_text_primary"
                    android:textSize="20sp"
                    android:letterSpacing="-0.02" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewAllCategories"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="See All"
                    android:textColor="@color/dash_accent"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />

            </RelativeLayout>

            <HorizontalScrollView
                android:id="@+id/categoriesScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:paddingHorizontal="17dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Personal Category -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCategoryPersonal"
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="3dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#0D000000">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@android:drawable/ic_menu_myplaces"
                                app:tint="@color/dash_accent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Personal"
                                android:textColor="@color/dash_text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tap to view"
                                android:textColor="@color/dash_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Work Category -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCategoryWork"
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="3dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#0D000000">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@android:drawable/ic_menu_agenda"
                                app:tint="@color/dash_accent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Work"
                                android:textColor="@color/dash_text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tap to view"
                                android:textColor="@color/dash_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Ideas Category -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardCategoryIdeas"
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="false"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="28dp"
                        app:cardElevation="3dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#0D000000">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/idea"
                                app:tint="@color/dash_accent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Ideas"
                                android:textColor="@color/dash_text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tap to view"
                                android:textColor="@color/dash_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>




        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fragment Container for other screens -->
    <FrameLayout
        android:id="@+id/main_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- New Reusable Stealth Navbar -->
    <com.kavya.stealthpad.ui.components.StealthNavBar
        android:id="@+id/stealth_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_bar_height"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateDrawable="@drawable/star_progress_indeterminate"
        android:visibility="gone"
        />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
