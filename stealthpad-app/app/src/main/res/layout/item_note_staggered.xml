<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_note"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/auth_dialog_bg"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/warm_white"
    android:clickable="true"
    android:focusable="true"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/note_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/lexend"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="@color/auth_title"
            android:textStyle="bold"
            tools:text="Meeting Discussion" />

        <TextView
            android:id="@+id/note_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="8"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="@color/auth_subtitle"
            tools:text="This is a snippet of the note content that can vary in length depending on how much detail is saved here..." />

        <com.google.android.material.chip.Chip
            android:id="@+id/category_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="false"
            android:fontFamily="@font/lexend"
            android:textColor="@color/white"
            app:chipBackgroundColor="@color/warm_accent"
            app:chipCornerRadius="8dp"
            app:chipMinHeight="24dp"
            app:ensureMinTouchTargetSize="false"
            tools:text="Work" />

        <TextView
            android:id="@+id/note_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.6"
            android:textAlignment="textEnd"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="@color/auth_subtitle"
            tools:text="Modified 2h ago" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
