<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.StealthPad" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/dash_accent</item>
        <item name="colorOnPrimary">@color/dash_bg</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/dash_text_secondary</item>
        <item name="colorOnSecondary">@color/dash_text_primary</item>
        <!-- Window background -->
        <item name="android:windowBackground">@color/dash_bg</item>
        <!-- Status bar and Navigation bar -->
        <item name="android:statusBarColor">@color/dash_bg</item>
        <item name="android:navigationBarColor">@color/dash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.StealthPad.Splash" parent="Theme.StealthPad">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
